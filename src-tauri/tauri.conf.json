{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aqueli",
  "version": "1.21.0",
  "identifier": "fr.aqueli.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Aqueli",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#8fd8fa",
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; connect-src ipc: http://ipc.localhost; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src blob:; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src blob:",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Aqueli",
    "copyright": "Aqueli",
    "category": "Productivity",
    "shortDescription": "Productivité personnelle, locale et hors ligne",
    "longDescription": "Aqueli réunit tâches, agenda, obligations et notes dans une seule application, entièrement hors ligne et chiffrée.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French", "Spanish", "PortugueseBR", "German", "Italian", "Dutch", "Polish", "Russian", "Ukrainian", "Turkish", "Hindi", "Indonesian", "Vietnamese", "SimpChinese", "Japanese", "Korean"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installateur/cote.bmp",
        "headerImage": "installateur/entete.bmp",
        "uninstallerHeaderImage": "installateur/entete.bmp",
        "customLanguageFiles": {
          "English": "installateur/langues/English.nsh",
          "French": "installateur/langues/French.nsh",
          "Spanish": "installateur/langues/Spanish.nsh",
          "PortugueseBR": "installateur/langues/PortugueseBR.nsh",
          "German": "installateur/langues/German.nsh",
          "Italian": "installateur/langues/Italian.nsh",
          "Dutch": "installateur/langues/Dutch.nsh",
          "Polish": "installateur/langues/Polish.nsh",
          "Russian": "installateur/langues/Russian.nsh",
          "Ukrainian": "installateur/langues/Ukrainian.nsh",
          "Turkish": "installateur/langues/Turkish.nsh",
          "Hindi": "installateur/langues/Hindi.nsh",
          "Indonesian": "installateur/langues/Indonesian.nsh",
          "Vietnamese": "installateur/langues/Vietnamese.nsh",
          "SimpChinese": "installateur/langues/SimpChinese.nsh",
          "Japanese": "installateur/langues/Japanese.nsh",
          "Korean": "installateur/langues/Korean.nsh"
        },
        "installerHooks": "installateur/crochets.nsh",
        "startMenuFolder": "Aqueli"
      }
    }
  }
}
